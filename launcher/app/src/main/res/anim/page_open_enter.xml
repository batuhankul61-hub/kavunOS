<?xml version="1.0" encoding="utf-8"?>
<!-- A page comes in: fades up from slightly smaller. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/apple_ease" android:shareInterpolator="true" android:duration="460">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale android:fromXScale="0.94" android:toXScale="1" android:fromYScale="0.94" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
</set>
